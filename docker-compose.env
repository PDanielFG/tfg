services:
  backend:
    build: ./backend    #Este docker-compose se usaba para montar las imágenes localmente, por eso es .env. Mientras que el .yml ya las monta desde dockerhub como debe de ser
    container_name: django_api
    ports:
      - "8000:8000"
    depends_on:
      - mysql
    environment:
      MYSQL_HOST: mysql
      MYSQL_DB: practica
      MYSQL_USER: test
      MYSQL_PASSWORD: test
    volumes:
      - ./backend:/app

  frontend:
    build: ./frontend
    container_name: vue_app
    ports:
      # - "8080:8080"
      - "8080:80" #PARA NGINX
    volumes:
      - ./frontend:/app
      - vue_node_modules:/app/node_modules 



  mysql:
    image: mysql:8.0
    container_name: mysql_logs
    restart: always
    environment:
      MYSQL_DATABASE: practica
      MYSQL_USER: test
      MYSQL_PASSWORD: test
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
      - ./backend/mysql-init:/docker-entrypoint-initdb.d

volumes:
  mysql_data:
  vue_node_modules:
